rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the two existing project accounts verified in Firebase console.
    // Creating or signing into another Firebase account never grants access.
    function staff() {
      return request.auth != null && request.auth.uid in [
        'rE1K7ZYGZicgsqgVyOBCCm5zvTp1',
        'jULRArueS7gig2T92FlxXHBYERn1'
      ];
    }
    function shortText(value, size) { return value is string && value.size() > 0 && value.size() <= size; }
    function contactEmail(value) {
      return shortText(value, 254) && value.matches("[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?([.][a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*");
    }
    function contactPhone(value) {
      return shortText(value, 25) && value.matches('[+]?[-0-9 ().]{7,25}')
        && value.matches('([^0-9]*[0-9]){7,}[^0-9]*');
    }
    function inquiryCreatedAt(value) {
      // Accept the current numeric client during the staged Timestamp rollout.
      // Bound new submissions only; existing inquiry dates remain readable.
      return (value is timestamp && value == request.time)
        || (value is number && value >= request.time.toMillis() - 900000
          && value <= request.time.toMillis() + 900000);
    }
    function image(value, size) {
      return value is string && value.size() <= size &&
        (value.matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+') || value.matches('/images/events/[a-zA-Z0-9_-]+[.]webp')
          || value.matches('/media/[a-f0-9]{16}-[a-zA-Z0-9_-]+[.]webp'));
    }
    // Public catalogue reads; only approved staff may manage products.
    match /products/{productId} {
      allow read: if resource.data.is_published == true || staff();
      allow create, update, delete: if staff();
    }
    match /inquiries/{inquiryId} {
      // Leave legacy intake working until the reviewed server cutover is ready.
      allow create: if (!exists(/databases/$(database)/documents/siteSettings/inquiryIntake)
        || get(/databases/$(database)/documents/siteSettings/inquiryIntake).data.server_only != true)
        && request.resource.data.keys().hasOnly([
        'name', 'hospital', 'department', 'email', 'phone', 'message',
        'items', 'type', 'status', 'created_at', 'is_deleted'
      ]) && shortText(request.resource.data.name, 120)
        && shortText(request.resource.data.hospital, 180)
        && shortText(request.resource.data.department, 200)
        && contactEmail(request.resource.data.email)
        && contactPhone(request.resource.data.phone)
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.items is list && request.resource.data.items.size() <= 500
        && request.resource.data.type in ['equipment', 'service']
        && request.resource.data.status == 'new'
        && (!('is_deleted' in request.resource.data) || request.resource.data.is_deleted == false)
        && inquiryCreatedAt(request.resource.data.created_at);
      allow read: if staff();
      // Staff can remove an inquiry from the inbox and restore it from Trash.
      allow update: if staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_deleted', 'deleted_at'])
        && request.resource.data.is_deleted is bool
        && ((request.resource.data.is_deleted == true && request.resource.data.deleted_at is number)
          || (request.resource.data.is_deleted == false && request.resource.data.deleted_at == null));
    }
    match /events/{eventId} {
      allow read: if resource.data.is_published == true || staff();
      allow create, update: if staff() && request.resource.data.keys().hasOnly([
        'title', 'category', 'event_date', 'location', 'summary', 'is_published', 'is_demo',
        'cover_image', 'cover_alt', 'photo_count', 'created_at', 'updated_at'
      ]) && shortText(request.resource.data.title, 140)
        && shortText(request.resource.data.location, 140)
        && shortText(request.resource.data.summary, 2000)
        && request.resource.data.category in ['Visit', 'Installation', 'Conference', 'Workshop', 'Training', 'Community']
        && request.resource.data.event_date is string
        && request.resource.data.event_date.matches('([0-9]{4}-[0-9]{2}-[0-9]{2})?')
        && request.resource.data.is_published is bool && request.resource.data.is_demo is bool
        && image(request.resource.data.cover_image, 65000)
        && shortText(request.resource.data.cover_alt, 240)
        && request.resource.data.photo_count is int && request.resource.data.photo_count >= 1 && request.resource.data.photo_count <= 10
        && request.resource.data.created_at is number && request.resource.data.updated_at is number;
      match /photos/{photoId} {
        allow read: if staff() || (resource.data.is_published == true && get(/databases/$(database)/documents/events/$(eventId)).data.is_published == true);
        allow create, update: if staff() && request.resource.data.keys().hasOnly(['src', 'thumbnail', 'alt', 'position', 'is_published', 'updated_at', 'asset_id'])
          && (image(request.resource.data.src, 650000) || (request.resource.data.src == '' && request.resource.data.asset_id == photoId))
          && (!('asset_id' in request.resource.data) || request.resource.data.asset_id == photoId) && image(request.resource.data.thumbnail, 65000)
          && shortText(request.resource.data.alt, 240)
          && request.resource.data.position is int && request.resource.data.position >= 0 && request.resource.data.position < 10
          && request.resource.data.is_published is bool && request.resource.data.updated_at is number;
      }
      match /photoAssets/{photoId} {
        allow read: if staff() || (resource.data.is_published == true
          && get(/databases/$(database)/documents/events/$(eventId)).data.is_published == true
          && get(/databases/$(database)/documents/events/$(eventId)/photos/$(photoId)).data.is_published == true);
        allow create, update: if staff()
          && request.resource.data.keys().hasOnly(['src', 'is_published', 'updated_at'])
          && image(request.resource.data.src, 650000)
          && request.resource.data.is_published is bool && request.resource.data.updated_at is number;
      }
    }
    match /siteSettings/inquiryIntake {
      allow read: if staff();
      allow create, update: if staff()
        && request.resource.data.keys().hasOnly(['server_only'])
        && request.resource.data.server_only is bool;
    }
    match /siteSettings/gallery {
      allow read: if true;
      allow create, update: if staff() && request.resource.data.keys().hasOnly(['show_demos', 'hidden_demo_ids'])
        && (!('show_demos' in request.resource.data) || request.resource.data.show_demos is bool)
        && (!('hidden_demo_ids' in request.resource.data) || (request.resource.data.hidden_demo_ids is list && request.resource.data.hidden_demo_ids.size() <= 6));
    }
    match /teamProfiles/{engineerId} {
      // Draft assets for future staff portraits are private.
      allow read: if staff();
      allow create, update: if staff() && engineerId in ['bahudar', 'prikshit', 'ashish', 'surender', 'virender']
        && request.resource.data.keys().hasOnly(['photo', 'updated_at'])
        && (request.resource.data.photo == '' || image(request.resource.data.photo, 250000))
        && request.resource.data.updated_at is number;
    }
  }
}
