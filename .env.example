# Firebase web app configuration (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gallery rules are deployed. Set false only for write-format rollback.
VITE_GALLERY_SPLIT_ASSETS_ENABLED=true
# Inquiry activation still requires the separate server credential and gate setup.
VITE_INQUIRY_API_ENABLED=false
# Server-only secrets (set in Vercel; never prefix these with VITE_):
# FIREBASE_SERVICE_ACCOUNT_JSON
# INQUIRY_SIGNING_KEY
# INQUIRY_API_ENABLED=false
